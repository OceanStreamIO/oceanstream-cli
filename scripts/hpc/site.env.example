# Site settings for scripts/hpc/*. Copy to scripts/hpc/site.env (gitignored)
# and fill in. Every value here is a placeholder.

# --- access -----------------------------------------------------------------
HPC_USER=myuser
HPC_LOGIN_HOST=login.example-hpc.org       # accepts sbatch for compute jobs
HPC_XFER_HOST=transfer.example-hpc.org     # runs queued S3 transfers
HPC_SSH_KEY=$HOME/.ssh/id_ed25519

# --- allocation ---------------------------------------------------------------
HPC_ACCOUNT=myaccount
HPC_QOS=normal
HPC_DEBUG_QOS=debug                        # short queue for first iterations
HPC_PARTITION=compute
HPC_CONSTRAINT=                            # e.g. highmem (node feature)
HPC_MEM_PER_CORE_GB=2                      # RAM per core without constraint
HPC_MEM_PER_CORE_GB_CONSTRAINED=8          # RAM per core with HPC_CONSTRAINT

# --- filesystems ---------------------------------------------------------------
HPC_PROJ=/path/to/persistent/project       # code, venv, logs  (oceanstream/ is appended)
HPC_SCRATCH=/path/to/scratch               # raw, products, tmp (oceanstream/ is appended)

# --- software --------------------------------------------------------------------
HPC_MODULES="python/3.12"                  # loaded before the venv is activated

# --- transfers ---------------------------------------------------------------------
HPC_XFER_RCLONE_CMD=rclone                 # or the site's queued wrapper
HPC_RCLONE_BIN=rclone                      # absolute path if not on the non-login PATH
HPC_DT_SLURM_CONF=                         # slurm.conf of the transfer cluster, if separate
HPC_RCLONE_REMOTE=oceanstream

# --- object storage ------------------------------------------------------------------
OCEANSTREAM_S3_BUCKET=my-bucket
OCEANSTREAM_S3_ENDPOINT=https://s3.example.com
OCEANSTREAM_S3_REGION=us-east-1
